# Tattle settings. Copy this file to .env next to compose.yaml, fill in the
# REQUIRED block, and leave the rest as is until you need it.
# Guide: docs/SELF-HOSTING.md

# ---- REQUIRED ----
# The address people type to reach Tattle, without a trailing slash.
# To try it on this computer only: http://localhost:3000
BETTER_AUTH_URL=https://tattle.example.org
# A long random secret. Generate it with: openssl rand -base64 32
# Never change it afterwards: everyone would be signed out.
BETTER_AUTH_SECRET=
# The database password. Generate it with: openssl rand -hex 24
# Used only when the database is created; changing it later breaks the connection.
POSTGRES_PASSWORD=

# ---- HTTPS (docker compose --profile https up -d) ----
# Your domain, already pointing at this server.
DOMAIN=tattle.example.org
# true behind Caddy, a hosting panel or any reverse proxy, so limits see real
# visitor IPs. Leave false when nothing sits in front of Tattle.
TRUST_PROXY=false

# ---- Optional ----
# Image version: latest, or a release like 0.1.0 to stay on it.
TATTLE_VERSION=latest
# Where the app listens on this machine. 127.0.0.1 = this machine only (behind
# a proxy). 0.0.0.0 = reachable at http://<server-ip>:APP_PORT.
APP_BIND=127.0.0.1
APP_PORT=3000
# Your own code for creating the first account. Default: one derived from
# BETTER_AUTH_SECRET, printed in the logs (docker compose logs app | grep setup).
SETUP_CODE=
# Let anyone create an account. Default: only the first account, then invitations.
ALLOW_SIGNUP=false
# Shortest password accepted (6 to 128).
MIN_PASSWORD_LENGTH=8
# Refuse passwords found in known data breaches (Have I Been Pwned; only the
# first 5 characters of the password's SHA-1 hash leave the server). Set to
# false on a server without internet access.
PASSWORD_BREACH_CHECK=true
# Let an OpenAI-compatible AI base URL point at this machine or a private
# network (Ollama, LM Studio…). Off: such addresses are refused.
AI_ALLOW_PRIVATE_URLS=false
# Widget reports allowed per IP per 10 minutes, and per project per hour.
INGEST_LIMIT_PER_IP=20
INGEST_LIMIT_PER_PROJECT=300

# ---- Email (optional) ----
# With SMTP set, invitations are emailed, "Forgot your password?" appears, and
# the team gets the notifications each person picks under their name →
# Notifications. Without it, invitations are links you send yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit TLS); 587 uses STARTTLS
SMTP_SECURE=false
SMTP_FROM="Tattle <tattle@example.org>"
# The hour (UTC, 0 to 23) of the daily triage digest.
TRIAGE_DIGEST_HOUR=8

# ---- Screenshot storage (optional) ----
# local (default): files in the "storage" volume. s3: any S3-compatible bucket
# (AWS S3, Cloudflare R2, Scaleway, OVH, Backblaze, RustFS, Garage…). The bucket
# stays private: screenshots are served by the app through signed links.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS; set it for every other provider, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for providers that need path-style URLs (RustFS, Garage, MinIO…)
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket, e.g. tattle/
S3_PREFIX=

# ---- Personal data (optional) ----
# Drop screenshots and console/network logs of reports older than this many days.
# The message, the reporter and the conversation stay; the device key goes once
# the conversation has been quiet as long. Empty: keep everything until you delete it.
REPORT_RETENTION_DAYS=
# Votes, emails and ideas per IP per 10 minutes on public feature-request pages.
PORTAL_LIMIT_PER_IP=30
# "My reports" in the widgets, per IP per 10 minutes: reads, and messages sent.
REPORTER_READ_LIMIT_PER_IP=120
REPORTER_MESSAGE_LIMIT_PER_IP=20
