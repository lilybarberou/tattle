{
  "name": "@tattle/react-native",
  "version": "0.1.0",
  "description": "Bug report and feedback widget for React Native and Expo apps: annotated screenshot, console logs, network requests and device info.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/collectors/*.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo-application": "*",
    "expo-crypto": "*",
    "expo-device": "*",
    "expo-secure-store": "*",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-safe-area-context": "*",
    "react-native-svg": ">=13",
    "react-native-view-shot": ">=3.6"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.1",
    "react-native-view-shot": "6.2.1",
    "typescript": "^6.0.2",
    "vitest": "5.1.0"
  }
}
