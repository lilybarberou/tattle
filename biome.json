{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/tests/**/*",
			"**/scripts/**/*",
			"**/e2e/**/*",
			"**/playwright.config.ts",
			"**/.vscode/**/*",
			"**/vite.config.ts",
			"**/vitest.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/.taste-skill",
			"!**/test-results",
			"!**/playwright-report"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		},
		"domains": {
			"playwright": "none"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/e2e/**/*"],
			"linter": {
				"rules": {
					"correctness": {
						"noEmptyPattern": "off"
					}
				},
				"domains": {
					"playwright": "recommended"
				}
			}
		}
	]
}
