{
  "name": "web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-widget.mjs",
    "prebuild": "node scripts/copy-widget.mjs",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@better-auth/cimd": "1.7.20",
    "@better-auth/mcp": "1.7.20",
    "@better-auth/oauth-provider": "1.7.20",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "^1.7.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "effect": "4.1.4",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "nodemailer": "10.5.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "esbuild": "0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
