# Postgres connection string
DATABASE_URL=postgres://tattle:tattle@localhost:5434/tattle
# Public URL of this server (used for auth callbacks, signed file URLs, MCP resource)
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ byte secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where screenshots are stored on disk
STORAGE_DIR=./storage
# Optional SMTP for invitations, password resets and notifications (docker-compose.dev.yml
# runs Mailpit: SMTP on localhost:1026, inbox at http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Tattle <tattle@localhost>"
# Optional: try the S3 driver against the RustFS of docker-compose.dev.yml
# STORAGE_DRIVER=s3
# S3_BUCKET=tattle-dev
# S3_ENDPOINT=http://localhost:9030
# S3_ACCESS_KEY_ID=tattle
# S3_SECRET_ACCESS_KEY=tattle-secret
# S3_FORCE_PATH_STYLE=true
