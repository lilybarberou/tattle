# Copy to .env (git ignores it), then restart `pnpm playground`.

# The Tattle server the playground reports to. Default: a local `pnpm dev`,
# http://localhost:3000 on the iOS Simulator, http://10.0.2.2:3000 on the
# Android emulator. On a real phone, use your computer's LAN address and start
# the server so it listens on it.
# EXPO_PUBLIC_TATTLE_URL=http://localhost:3000

# Public key of a project on that server (its settings page, "Install").
EXPO_PUBLIC_TATTLE_PROJECT_KEY=pk_...
